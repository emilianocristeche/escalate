# Copy to .env and adjust. Omit DATABASE_URL to use a local SQLite file.
# docker-compose sets this to the Postgres service automatically.
DATABASE_URL=postgresql+psycopg2://escalate:escalate@db:5432/escalate

# Browser origins allowed by CORS (comma-separated). Default: the local Vite dev
# server only. In production, set it to the dashboard URL.
# CORS_ORIGINS=https://your-dashboard.vercel.app

# Public-deploy hardening (see README "Security").
# ESCALATE_READ_ONLY=false         # true = reject all writes (demo mode)
# ESCALATE_WRITE_RATE_LIMIT=10     # writes per client IP per window; 0 = off
# ESCALATE_RATE_WINDOW_SEC=60
# ESCALATE_TRUST_PROXY=false       # true behind Render/any reverse proxy
# ESCALATE_SEED_DEMO=false         # true = fill an EMPTY DB with synthetic demo tickets on startup

# Optional LLM classifier: OFF unless ESCALATE_ENABLE_LLM=true AND a key is set.
# ESCALATE_ENABLE_LLM=false
# ANTHROPIC_API_KEY=
